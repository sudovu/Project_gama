{
  "name": "gama-music-windows",
  "version": "1.0.0",
  "description": "GAMA - Cybernetic Music Frequency Platform for Windows Desktop",
  "main": "src/main/main.js",
  "author": "VHUWON MATHERS",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.gama.music",
    "productName": "GAMA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
