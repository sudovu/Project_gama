# GAMMA Environment Configuration
# Copy this file to .env and fill in your values

# YouTube Data API (for future integration)
# Get your API key from: https://console.cloud.google.com/
# IMPORTANT: Never commit real API keys to version control
YOUTUBE_API_KEY=your_api_key_here

# OAuth Configuration (for authenticated features)
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/callback

# Backend API (if using a backend service)
# Only required if implementing server-side features
API_BASE_URL=https://api.example.com
API_VERSION=v1

# Analytics (optional, privacy-conscious)
# Only track essential events, never sensitive data
ANALYTICS_ENABLED=false
ANALYTICS_KEY=your_analytics_key_here

# Feature Flags
FEATURE_BACKGROUND_PLAYBACK=false
FEATURE_OFFLINE_MODE=false
FEATURE_SOCIAL=false
FEATURE_RECOMMENDATIONS=false

# Environment
NODE_ENV=development
VITE_APP_VERSION=1.0.0
